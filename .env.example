# Copy to .env for local development and deploy.
# Never commit .env or .secrets.env.

# Required for runtime and deploy:production
SERVICE_API_KEY=your-secret-key
CORS_ALLOWED_ORIGINS=https://delman.it,https://delman-site.pages.dev

# Optional overrides (defaults in deploy.config.json)
# GCP_PROJECT_ID=delman-site
# GCP_REGION=europe-west3

# Optional centralized deploy manifest bucket (R2)
# DEPLOY_MANIFEST_R2_BUCKET=delman-site-data
